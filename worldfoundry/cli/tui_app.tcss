Screen {
    layout: vertical;
    background: $background;
    color: $text;
    /* Nerd Font icons: configure terminal font (see docs/guides/tui), not Textual CSS */
}

Header {
    background: $surface;
    color: $text;
    text-style: bold;
    dock: top;
    height: 1;
    border: none;
}

Footer {
    background: $surface;
    dock: bottom;
    height: 1;
    color: $text-muted;
    border-top: none;
}

/* ── Status Pane (Top Left) ── */
#status-pane {
    height: auto;
    padding: 1;
    margin-bottom: 1;
    background: $panel;
    border: round $border-blurred;
    border-title-color: $text;
}

#status-pane.mode-infer,
#status-pane.mode-eval,
#status-pane.mode-ui {
    border-title-color: $text;
}

#brand-collapse {
    border: none;
    background: transparent;
    margin-bottom: 0;
    padding: 0;
    height: auto;
    overflow: hidden;
}

#brand-collapse > CollapsibleTitle {
    padding: 0;
    color: $text-muted;
}

#brand-logo {
    width: 1fr;
    height: auto;
    content-align: center middle;
    margin: 0;
}

#action-row {
    height: 3;
    margin: 0;
    align: left middle;
}

#status-divider {
    margin: 0;
    color: $border-blurred;
}

#action-label {
    height: 3;
    content-align: left middle;
    padding-right: 1;
    color: $text-muted;
    text-style: bold;
}

#action {
    width: 1fr;
    height: 3;
    border: none;
    background: transparent;
    border-bottom: tall $border-blurred;
}

#conda-status {
    color: $text-muted;
    content-align: left top;
    width: 1fr;
    height: auto;
    padding: 0;
    margin-top: 0;
}

/* ── Main layout ── */
#main-content {
    height: 1fr;
    min-height: 0;
    padding: 1 1;
}

Screen.-narrow #main-content {
    layout: vertical;
    overflow-y: auto;
}

Screen.-narrow #left-column {
    width: 1fr;
    min-width: 0;
    height: auto;
}

Screen.-narrow #catalogs-pane {
    height: 12;
}

Screen.-narrow #right-column {
    width: 1fr;
    min-width: 0;
    height: auto;
    margin-left: 0;
    margin-top: 1;
}

Screen.-compact #main-content,
Screen.-short #main-content {
    padding: 0 1;
}

Screen.-hide-brand #brand-collapse,
Screen.-hide-brand #status-divider,
Screen.-compact #brand-collapse,
Screen.-short #brand-collapse,
Screen.-compact #status-divider,
Screen.-short #status-divider {
    display: none;
}

Screen.-hide-brand #status-pane,
Screen.-compact #status-pane,
Screen.-short #status-pane {
    padding: 0 1;
}

Screen.-compact #search-row,
Screen.-short #search-row {
    margin-bottom: 0;
}

Screen.-compact #catalogs-pane,
Screen.-short.-narrow #catalogs-pane {
    height: 10;
}

#left-column {
    width: 2fr;
    height: 100%;
    min-width: 44;
}

#catalogs-pane {
    height: 1fr;
    border: round $border-blurred;
    border-title-color: $text;
    background: $panel;
    padding: 0 1;
    overflow-y: hidden;
}

#right-column {
    width: 3fr;
    height: 100%;
    min-width: 40;
    margin-left: 1;
    padding-bottom: 1;
    overflow-y: auto;
}

#search-row {
    height: 3;
    margin-bottom: 0;
}

#filter {
    width: 1fr;
    border: none;
    border-bottom: tall $border-blurred;
    background: $surface;
    color: $text;
}

#filter:focus {
    border-bottom: tall $accent;
    background: $surface-active;
}

#catalogs {
    height: 1fr;
    min-height: 10;
}

.pane {
    width: 1fr;
    height: 100%;
}

.pane-full {
    width: 1fr;
}

#models-pane, #benchmarks-pane {
    height: 1fr;
    min-height: 4;
}

.pane-title {
    height: 1;
    text-style: bold;
    color: $text;
    padding: 0;
    margin-bottom: 0;
}

DataTable {
    height: 1fr;
    min-height: 2;
    border: none;
    background: $panel;
    color: $text;
    scrollbar-background: $scrollbar-background;
    scrollbar-color: $scrollbar;
}

DataTable:focus {
    border: none;
}

DataTable > .datatable--cursor {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
    text-style: bold;
}

DataTable > .datatable--header {
    background: $surface;
    text-style: bold;
    color: $text-muted;
}

DataTable > .datatable--hover {
    background: $block-hover-background;
}

DataTable > .datatable--odd-row {
    background: $panel;
}

DataTable > .datatable--even-row {
    background: $surface;
}

.catalog-empty {
    height: auto;
    padding: 1 0;
    color: $text-muted;
}

#summary-row {
    height: auto;
    margin-bottom: 1;
}

/* ── Selection card ── */
#brand-panel {
    height: auto;
    width: 1fr;
    margin: 0 1 1 1;
    align: center middle;
    background: transparent;
}

#selection-summary {
    width: 1fr;
    height: auto;
    min-height: 4;
    padding: 0 1;
    margin-bottom: 1;
    border: round $border-blurred;
    border-title-color: $text-muted;
    background: transparent;
}

#run-builder {
    height: auto;
    border: round $border-blurred;
    border-title-color: $text;
    background: $panel;
    padding: 0;
}

#run-controls {
    layout: grid;
    grid-size: 3;
    grid-columns: 10 10 1fr;
    grid-rows: 3;
    height: 4;
    padding: 0 1;
    border-bottom: solid $border-blurred;
    align: left middle;
    background: transparent;
}

#secondary-actions {
    layout: grid;
    grid-size: 6;
    grid-columns: 1fr 1fr 1fr 1fr 1fr 1fr;
    width: 1fr;
    height: 3;
    margin-left: 0;
}

Screen.-stack-actions #run-controls {
    grid-size: 2;
    grid-columns: 10 1fr;
    grid-rows: 3 3;
    height: 7;
}

Screen.-stack-actions #secondary-actions {
    column-span: 2;
}

Screen.-compact #secondary-actions {
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: 3 3;
    height: 6;
}

Screen.-compact #run-controls {
    grid-rows: 3 6;
    height: 10;
}

Screen.-compact .field-grid {
    grid-size: 1;
    grid-columns: 1fr;
}

Screen.-compact .full-width {
    column-span: 1;
}

Button {
    height: 3;
    border: none;
    margin-right: 1;
    min-width: 7;
    background: $surface-lighten-1;
    color: $text;
    text-style: bold;
}

Button.-success {
    min-width: 8;
    background: $primary;
    color: $background;
}
Button.-success:hover { background: $primary-lighten-1; }

Button.-error {
    min-width: 8;
    background: $surface-lighten-1;
    color: $error;
}
Button.-error:hover { background: $error-muted; }

Button.-primary {
    background: $surface-lighten-1;
    color: $text;
}
Button.-primary:hover { background: $surface-lighten-2; }

Button:disabled {
    opacity: 0.5;
}

Button:hover {
    background: $surface-lighten-2;
}

Button:focus {
    border-bottom: tall $accent;
}

/* ── Config tabs ── */
#config-tabs {
    height: auto;
    min-height: 0;
    border: none;
    background: transparent;
}

TabbedContent > ContentSwitcher {
    height: auto;
    padding: 1 1 0 1;
}

TabbedContent Tabs {
    background: $panel;
    border: none;
    padding: 0 1;
}

TabbedContent Tab {
    color: $text-muted;
    padding: 0 1;
    border: none;
}

TabbedContent Tab.-active {
    color: $accent;
    text-style: bold;
    background: transparent;
}

TabbedContent Tab:disabled {
    opacity: 0.5;
}

TabPane {
    padding: 0;
    height: auto;
}

.tab-scroll {
    height: auto;
    padding: 0;
}

.section-title {
    height: auto;
    text-style: bold;
    color: $text;
    padding: 0;
}

.section-rule {
    margin: 0;
    color: $border-blurred;
}

/* ── Form fields ── */
.field-grid {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 0 1;
    height: auto;
    padding: 0;
    margin-bottom: 0;
}

.field-group {
    height: auto;
    width: 1fr;
    padding: 0;
    margin-bottom: 1;
}

.full-width {
    column-span: 2;
}

.field-caption {
    height: auto;
    color: $text-muted;
    text-style: bold;
    padding: 0 0 0 0;
}

.field-group Input,
.field-group Select,
.field-grid Input,
.field-grid Select {
    width: 1fr;
    height: 3;
    margin: 0;
    background: $surface;
    border: none;
    border-bottom: tall $border-blurred;
    color: $text;
}

Input:focus,
Select:focus {
    border: none;
    border-bottom: tall $accent;
    background: $surface-active;
}

.tab-empty {
    height: auto;
    padding: 2 1;
    color: $text-muted;
    text-style: italic;
    content-align: center middle;
}

/* ── Studio panel ── */
#studio-panel {
    height: auto;
    min-height: 6;
    margin-top: 1;
    border: none;
    border-left: thick $accent;
    background: $panel;
    padding: 1 2;
}

#studio-help-title {
    text-style: bold;
    color: $text;
    height: auto;
    padding-bottom: 0;
}

#studio-help {
    height: auto;
    color: $text;
    padding-top: 1;
}

#status-bar {
    height: auto;
    padding: 1 1 0 1;
    border-top: solid $border-blurred;
}

#selection-status {
    height: auto;
    min-height: 1;
    color: $text-muted;
    text-style: italic;
}

#command-validation {
    display: none;
    height: auto;
    margin: 0 1 1 1;
    padding: 0 1;
    border-left: solid $warning;
    color: $warning;
}

/* ── Command preview ── */
#command-preview {
    margin-top: 0;
    margin-bottom: 1;
    padding: 0 1;
    border: none;
    background: $surface;
}

#command-preview.-collapsed {
    background: transparent;
}

#command {
    height: auto;
    max-height: 8;
    overflow-y: auto;
    padding: 0 1;
    background: transparent;
}

Collapsible {
    border: none;
    background: transparent;
}

CollapsibleTitle {
    background: transparent;
    color: $text-muted;
    text-style: bold;
    padding: 0 1;
}

/* ── Log panel ── */
#log-panel {
    height: 8;
    min-height: 6;
    margin: 1 0 0 0;
    border: round $border-blurred;
    border-title-color: $text-muted;
    background: $surface;
    padding: 0 1;
}

.log-title {
    height: 1;
    padding: 1 0 0 0;
    color: $text-muted;
    text-style: bold;
}

#logs {
    height: 1fr;
    border: none;
    background: transparent;
    padding-top: 0;
    scrollbar-background: $scrollbar-background;
    scrollbar-color: $scrollbar;
}

Screen.-compact #log-panel,
Screen.-short #log-panel {
    height: 8;
}

Screen.-compact #selection-summary {
    margin-bottom: 0;
}

Screen.-compact #search-row,
Screen.-short #search-row {
    height: 3;
}
