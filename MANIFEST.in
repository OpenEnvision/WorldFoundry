include .pre-commit-config.yaml
include THIRD-PARTY-NOTICES
include worldfoundry/base_models/three_dimensions/depth/vigeo/PROVENANCE.md
recursive-include requirements *.txt *.md
include worldfoundry/data/benchmarks/*.yaml
include worldfoundry/data/benchmarks/*.md
recursive-include worldfoundry/data/benchmarks/catalog *.yaml
recursive-include worldfoundry/data/benchmarks/tasks *.yaml
recursive-include worldfoundry/data/benchmarks/runtime_profiles *.yaml
recursive-include worldfoundry/data/benchmarks/assets *.json *.jsonl *.csv *.txt *.md *.png
recursive-include worldfoundry/data/benchmarks/assets/larybench *.yaml
recursive-include worldfoundry/evaluation/tasks/execution/runners/larybench *.md LICENSE.*
recursive-include worldfoundry/synthesis/visual_generation/moverse/moverse_runtime *
recursive-include worldfoundry/synthesis/visual_generation/uni3c/uni3c_runtime *
recursive-include worldfoundry/synthesis/visual_generation/evoke/evoke_runtime *
recursive-include worldfoundry/synthesis/visual_generation/world_model/mira_wm *.py *.md *.txt
recursive-include worldfoundry/synthesis/visual_generation/rcm/rcm_runtime *.py *.md
recursive-include worldfoundry/evaluation/tasks/execution/runners/physics_iq/official *.py
recursive-include worldfoundry/evaluation/tasks/execution/runners/chronomagic_bench/runtime/chronomagic_bench/MTScore/configs *.json
include worldfoundry/evaluation/tasks/execution/runners/devil_dynamics/runtime/official/cal_temporal_info.sh
recursive-include worldfoundry/evaluation/tasks/execution/runners/ewmbench/runtime/ewmbench *.yaml *.yml
recursive-include worldfoundry/evaluation/tasks/execution/runners/fetv/runtime/fetv_eval *.py *.cpp *.cu *.h *.txt *.yaml *.yml *.json
recursive-include worldfoundry/evaluation/tasks/execution/runners/phyfps_bench_gen/runtime/visual_chronometer/inference/configs *.yaml *.yml
recursive-include worldfoundry/evaluation/tasks/execution/runners/pawbench/runtime *.py *.yaml *.yml *.md *.txt *.cff LICENSE
recursive-include worldfoundry/evaluation/tasks/execution/runners/t2v_compbench/runtime/t2v_compbench/dot/configs *.json
recursive-include worldfoundry/evaluation/tasks/execution/runners/vbench_plus_plus/runtime/vbench2_beta_long/configs *.yaml *.yml
recursive-include worldfoundry/evaluation/tasks/execution/runners/vmbench/runtime/official *.py *.sh *.txt *.md *.yaml *.yml *.json
recursive-include worldfoundry/evaluation/tasks/execution/runners/wbench/runtime/wbench *.yaml *.yml
recursive-include worldfoundry/evaluation/tasks/execution/runners/world_in_world/runtime/official *.py *.sh *.txt *.md *.yaml *.yml *.json
recursive-include worldfoundry/evaluation/tasks/execution/runners/worldarena/runtime/video_quality *.yaml *.yml
recursive-include worldfoundry/evaluation/tasks/execution/runners/wrbench/runtime *.py *.json *.txt *.md LICENSE
recursive-include worldfoundry/base_models/perception_core/video_text/fetv_blip *.py *.json *.yaml *.yml *.txt
recursive-include worldfoundry/base_models/perception_core/video_quality/fetv_stylegan_v *.py *.cpp *.cu *.h *.json *.yaml *.yml *.txt
recursive-include worldfoundry/base_models/three_dimensions/general_3d/vipe/csrc *.cpp *.cu *.h *.cuh
include worldfoundry/base_models/three_dimensions/general_3d/vipe/THIRD_PARTY_LICENSES.md
recursive-include worldfoundry/studio/native/world_explorer *
recursive-include worldfoundry/data/models/catalog *.yaml
recursive-include worldfoundry/data/models/runtime *.yaml
recursive-include worldfoundry/data/models/runtime *.json
include worldfoundry/synthesis/visual_generation/ctrl_world/action_stats.json
recursive-include worldfoundry/data/models/bindings *.yaml
recursive-include worldfoundry/data/models/runtime/configs *.yaml
recursive-include worldfoundry/data/models/runtime/configs *.yml
recursive-include worldfoundry/data/models/runtime/configs *.json
recursive-include worldfoundry/data/models/runtime/configs *.py *.md
recursive-include worldfoundry/data/models/runtime/environments *.yaml
# Keep source distributions reproducible from a dirty development checkout.
prune tmp
prune tests
prune cache
prune cache*
prune outputs
prune output
prune data/hfd_datasets
prune data/bench_results
prune data/benchmark_zoo
prune assets/datasets
prune assets/repos
prune worldfoundry/data/test_cases
prune docs/fumadocs/.next
prune docs/fumadocs/out
prune docs/fumadocs/node_modules
prune worldfoundry/studio/native/world_explorer/build
prune worldfoundry/studio/native/world_explorer/dependencies/fmt
prune worldfoundry/studio/native/world_explorer/dependencies/glfw
prune worldfoundry/studio/native/world_explorer/dependencies/imgui
prune worldfoundry/studio/native/world_explorer/dependencies/pybind11
prune worldfoundry/studio/native/world_explorer/dependencies/tinylogger
prune worldfoundry/studio/assets/vendor

# License-gated upstream runtimes are allowed as ignored local checkouts only.
prune worldfoundry/base_models/three_dimensions/depth/dvlt/dvlt_runtime
prune worldfoundry/base_models/three_dimensions/depth/unik3d
prune worldfoundry/base_models/three_dimensions/general_3d/dust3r
prune worldfoundry/base_models/three_dimensions/general_3d/four_d_gaussians
prune worldfoundry/base_models/three_dimensions/general_3d/mast3r
prune worldfoundry/base_models/three_dimensions/general_3d/monst3r
prune worldfoundry/base_models/three_dimensions/general_3d/stable_virtual_camera
prune worldfoundry/base_models/three_dimensions/point_clouds/gaussian_splatting
prune worldfoundry/base_models/three_dimensions/point_clouds/pi3
prune worldfoundry/base_models/three_dimensions/slam/mega_sam_runtime/UniDepth
prune worldfoundry/synthesis/visual_generation/hunyuan_world/hunyuan_game_craft
prune worldfoundry/synthesis/visual_generation/hunyuan_world/hunyuan_world_voyager
prune worldfoundry/synthesis/visual_generation/hunyuan_world/hy_world_2p0_panogen_runtime
prune worldfoundry/synthesis/visual_generation/hunyuan_world/hy_world_2p0_worldgen_runtime
prune worldfoundry/synthesis/visual_generation/krea_realtime/realtime_video_runtime
prune worldfoundry/synthesis/visual_generation/open_sora/open_sora_runtime
prune worldfoundry/synthesis/visual_generation/vmem/vmem_runtime/extern/CUT3R
prune worldfoundry/synthesis/visual_generation/wonderworld/wonderworld_runtime
prune thirdparty/diff-gaussian-rasterization
prune thirdparty/SageAttention
prune thirdparty/simple-knn

# Upstream runtime mirrors should ship source code, not demo galleries, notebooks,
# eval question dumps, or bundled sample media.
prune worldfoundry/synthesis/visual_generation/pandora/pandora_runtime/ChatUniVi/eval
prune worldfoundry/synthesis/visual_generation/pandora/pandora_runtime/ChatUniVi/train
prune worldfoundry/synthesis/visual_generation/dynamicrafter_pandora/DynamiCrafter/assets
prune worldfoundry/synthesis/visual_generation/dynamicrafter_pandora/DynamiCrafter/prompts
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
global-exclude *.7z *.arrow *.bz2 *.ckpt *.feather *.gguf *.gz *.h5 *.hdf5
global-exclude *.gif *.ipynb *.pdf
global-exclude *.mlmodel *.mp4 *.npy *.npz *.onnx *.parquet *.pickle *.pkl
global-exclude *.pt *.pth *.rar *.safetensors *.sqlite *.sqlite3 *.tar *.tgz *.zip *.zst

# Public source contains inference and evaluation only.
prune worldfoundry/training
exclude worldfoundry/cli/training.py
prune worldfoundry/cli/training_commands
prune scripts/training
prune configs/training
prune configs/post_training
prune test
prune tests
prune test_stream
exclude pytest.ini
exclude docs/fumadocs/content/docs/guides/training.mdx
exclude docs/fumadocs/content/docs/guides/training.zh.mdx
global-exclude */test/* */tests/* */testing/* conftest.py pytest.ini

prune testcase
global-exclude test_*.py *_test.py test_*.cpp *_test.cpp

